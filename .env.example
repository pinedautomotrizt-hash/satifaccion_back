PORT=3000

# Conexión MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=satisfaccion

# Estados de la OT en los que el cliente puede votar (separados por coma)
ESTADOS_PERMITIDOS=CERRADO

# Clave para el panel de administración (importar OT y ver resultados)
ADMIN_API_KEY=cambia-esta-clave

# Orígenes permitidos para el frontend (separados por coma). Vacío = cualquiera
CORS_ORIGIN=http://localhost:4321
